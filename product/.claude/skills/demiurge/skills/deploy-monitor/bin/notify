#!/usr/bin/env python3
"""macOS 배너 알림. 사용법: notify <start|anomaly|done|auth> <message>

문구는 AppleScript 소스에 끼우지 않고 argv로 넘긴다(따옴표·역슬래시 안전).
anomaly·auth만 Glass 소리를 낸다. 실패 시 stderr에 NOTIFY_FAILED, exit 1.
알 수 없는 kind는 exit 2.
"""

import subprocess
import sys

TITLE = "deploy-monitor"
KINDS = {"start": False, "anomaly": True, "done": False, "auth": True}


def main(argv):
    if len(argv) != 3 or argv[1] not in KINDS:
        print(
            "usage: notify <start|anomaly|done|auth> <message>", file=sys.stderr
        )
        return 2
    kind, message = argv[1], argv[2]
    display = "display notification (item 1 of argv) with title (item 2 of argv)"
    if KINDS[kind]:
        display += ' sound name "Glass"'
    cmd = [
        "osascript",
        "-e", "on run argv",
        "-e", display,
        "-e", "end run",
        message,
        TITLE,
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"NOTIFY_FAILED: {exc}", file=sys.stderr)
        return 1
    if result.returncode != 0:
        reason = result.stderr.strip() or f"osascript exit {result.returncode}"
        print(f"NOTIFY_FAILED: {reason}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
