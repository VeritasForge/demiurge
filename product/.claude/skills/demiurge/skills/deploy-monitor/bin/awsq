#!/usr/bin/env python3
"""AWS CloudWatch 조회. 결과는 stdout JSON.

  awsq logs --region R --log-group G [--log-group G2 ...] --start EPOCH --end EPOCH
            --query-file F [--limit 1000] [--max-wait 120]
  awsq metric --region R --namespace N --metric M --dimension Key=Value [...]
            --start EPOCH --end EPOCH [--period 300] [--stat Maximum]

logs 창은 [start, end) 다. Logs Insights 의 end-time 은 그 초를 포함하므로 end-1 을 넘긴다.
logs 는 결과를 최대 --max-wait 초 기다리고, 넘기면 AWS_ERROR 줄에 queryId 를 남기고 exit 2
(쿼리는 AWS 쪽에서 계속 돌며 과금된다 — 다시 돌리기 전에 대기 한도를 늘릴지 판단한다).
metric 의 --dimension Key=Value 는 aws-cli shorthand Name=Key,Value=Value 로 바꿔 넘긴다.

종료 코드: 0 성공, 2 조회 실패(AWS_ERROR), 3 자격증명 만료·없음(AWS_AUTH_EXPIRED).
logs 폴링 간격은 환경변수 AWSQ_POLL_SECONDS(기본 2초)로 바꾼다.
"""

import argparse
import datetime
import json
import os
import subprocess
import sys
import time

TERMINAL = {"Complete", "Failed", "Cancelled", "Timeout"}
EXPIRED_MARKERS = (
    "session has expired",
    "reauthenticate",
    "expiredtoken",
    "unable to locate credentials",
    "error loading sso token",
    "token has expired",
    "security token included in the request is expired",
)


class AwsError(Exception):
    def __init__(self, message, expired=False):
        super().__init__(message)
        self.expired = expired


def first_line(text):
    lines = text.strip().splitlines()
    return lines[0] if lines else ""


def aws(region, *args):
    cmd = ["aws", *args, "--region", region, "--output", "json"]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as exc:
        raise AwsError(str(exc))
    if result.returncode != 0:
        stderr = result.stderr
        expired = any(m in stderr.lower() for m in EXPIRED_MARKERS)
        raise AwsError(first_line(stderr) or f"aws exit {result.returncode}", expired)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise AwsError(f"invalid aws output: {exc}")


def iso(epoch):
    moment = datetime.datetime.fromtimestamp(int(epoch), datetime.timezone.utc)
    return moment.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_timestamp(text):
    # Python < 3.11 의 fromisoformat 은 끝의 Z 를 읽지 못한다.
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    return int(datetime.datetime.fromisoformat(text).timestamp())


def cmd_logs(args):
    with open(args.query_file) as f:
        query = f.read()
    started = aws(
        args.region, "logs", "start-query",
        "--log-group-names", *args.log_group,
        "--start-time", str(int(args.start)),
        "--end-time", str(int(args.end) - 1),
        "--query-string", query,
        "--limit", str(args.limit),
    )
    query_id = started["queryId"]
    interval = float(os.environ.get("AWSQ_POLL_SECONDS", "2"))
    deadline = time.monotonic() + args.max_wait
    while True:
        data = aws(args.region, "logs", "get-query-results", "--query-id", query_id)
        status = data.get("status", "")
        if status in TERMINAL:
            break
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise AwsError(
                f"query did not finish within {args.max_wait:g}s: still "
                f"{status or 'unknown'} (queryId {query_id})"
            )
        time.sleep(min(interval, remaining))
    if status != "Complete":
        raise AwsError(f"query status {status}")
    rows = [
        {c["field"]: c["value"] for c in row if c["field"] != "@ptr"}
        for row in data.get("results", [])
    ]
    scanned = data.get("statistics", {}).get("bytesScanned", 0.0)
    return {"status": status, "rows": rows, "bytes_scanned": scanned}


def dimension_arg(item):
    key, sep, value = item.partition("=")
    if not sep or not key or not value:
        raise AwsError(f"dimension must be Key=Value: {item}")
    return f"Name={key},Value={value}"


def cmd_metric(args):
    dimensions = [dimension_arg(d) for d in args.dimension]
    data = aws(
        args.region, "cloudwatch", "get-metric-statistics",
        "--namespace", args.namespace,
        "--metric-name", args.metric,
        "--dimensions", *dimensions,
        "--start-time", iso(args.start),
        "--end-time", iso(args.end),
        "--period", str(args.period),
        "--statistics", args.stat,
    )
    points = [
        {
            "t": parse_timestamp(p["Timestamp"]),
            "v": p[args.stat],
        }
        for p in data.get("Datapoints", [])
    ]
    points.sort(key=lambda p: p["t"])
    return {"datapoints": points}


def build_parser():
    parser = argparse.ArgumentParser(prog="awsq")
    sub = parser.add_subparsers(dest="cmd", required=True)
    logs = sub.add_parser("logs")
    logs.add_argument("--region", required=True)
    logs.add_argument("--log-group", action="append", required=True)
    logs.add_argument("--start", type=float, required=True)
    logs.add_argument("--end", type=float, required=True)
    logs.add_argument("--query-file", required=True)
    logs.add_argument("--limit", type=int, default=1000)
    logs.add_argument("--max-wait", type=float, default=120)
    logs.set_defaults(func=cmd_logs)
    metric = sub.add_parser("metric")
    metric.add_argument("--region", required=True)
    metric.add_argument("--namespace", required=True)
    metric.add_argument("--metric", required=True)
    metric.add_argument("--dimension", action="append", required=True)
    metric.add_argument("--start", type=float, required=True)
    metric.add_argument("--end", type=float, required=True)
    metric.add_argument("--period", type=int, default=300)
    metric.add_argument("--stat", default="Maximum")
    metric.set_defaults(func=cmd_metric)
    return parser


def main(argv):
    args = build_parser().parse_args(argv[1:])
    try:
        result = args.func(args)
    except OSError as exc:
        print(f"AWS_ERROR: {exc}", file=sys.stderr)
        return 2
    except (KeyError, ValueError, TypeError) as exc:
        print(f"AWS_ERROR: unexpected aws output: {exc!r}", file=sys.stderr)
        return 2
    except AwsError as exc:
        tag = "AWS_AUTH_EXPIRED" if exc.expired else "AWS_ERROR"
        print(f"{tag}: {exc}", file=sys.stderr)
        return 3 if exc.expired else 2
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
