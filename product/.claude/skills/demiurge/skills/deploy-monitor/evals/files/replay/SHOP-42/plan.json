{
  "ticket": "SHOP-42",
  "repo": "shop-api",
  "region": "ap-northeast-1",
  "log_groups": [
    "/ecs/shop-api-prod"
  ],
  "error_level": "ERROR",
  "watch": {
    "refund_api_fail": "환불 API 호출 실패",
    "user_not_found": "user_not_found"
  },
  "success": {
    "refund_ok": "환불 처리 완료"
  },
  "metrics": [
    {
      "label": "cpu",
      "namespace": "AWS/ECS",
      "metric": "CPUUtilization",
      "dimensions": [
        "ClusterName=shop-prod",
        "ServiceName=shop-api-prod"
      ],
      "stat": "Maximum",
      "limit": 80
    }
  ],
  "sentry": null,
  "period_minutes": 60,
  "cron_job_id": null,
  "baseline_hours": 168,
  "baseline_bytes": 734003200,
  "logs_price_per_gb": 0.0076,
  "bin": "<사본 준비 때 bin 절대경로로 바꾼다>"
}
