{
  "family": "shop-api-prod",
  "containerDefinitions": [
    {
      "name": "shop-api",
      "image": "shop-api:latest",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shop-api-prod",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
